PORT=5000
NODE_ENV=development

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

JWT_SECRET=change_this_secret

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_study_planner
DB_SSL=false

# Alternative for hosted MySQL providers:
# DATABASE_URL=mysql://user:password@host:3306/database

# Optional AI provider used by backend/src/controllers/aiController.js
GROQ_API_KEY=

# Optional legacy fallback; current AI controller uses Groq.
OPENAI_API_KEY=

# Password reset email. For Gmail, use an App Password, not your normal password.
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=Smart Study <youremail@gmail.com>
# Optional custom SMTP provider:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
