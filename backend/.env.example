PORT=5000
NODE_ENV=development

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

JWT_SECRET=change_this_secret

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_study_planner
DB_SSL=false

# Alternative for hosted MySQL providers:
# DATABASE_URL=mysql://user:password@host:3306/database

# Optional AI provider used by backend/src/controllers/aiController.js
GROQ_API_KEY=

# Optional legacy fallback; current AI controller uses Groq.
OPENAI_API_KEY=

# Password reset email. Prefer RESEND_API_KEY on Render. Gmail SMTP is fallback only.
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=Smart Study <youremail@gmail.com>
# Optional custom SMTP provider:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# Recommended on Render: Resend HTTP email API avoids SMTP connection timeout.
RESEND_API_KEY=
# Example after verifying a domain in Resend:
# EMAIL_FROM=Smart Study <noreply@yourdomain.com>
